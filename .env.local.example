# Copy to .env.local. Never commit the real file.
# DATABASE_URL is overridden by docker-compose.local.yml to use the db service.
NEXTAUTH_SECRET=replace-with-a-long-random-local-secret
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Telegram Mini App / bot integration.
BOT_TOKEN=replace-with-test-bot-token
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_DEMO_BOT=topka_demo_bot
NEXT_PUBLIC_DEMO_STARTAPP=topka

# Optional owner/bootstrap settings.
UFO_SUPERADMIN_TELEGRAM_ID=
SUPERADMIN_TELEGRAM_IDS=
UFO_BOOTSTRAP_OWNER_TELEGRAM_IDS=
UFO_OWNER_NOTIFY_TELEGRAM_IDS=

# Optional payments. Leave empty for local cash/QR-only smoke tests.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional local tunnel host, without protocol, for Next allowedDevOrigins.
CF_TUNNEL_HOST=

